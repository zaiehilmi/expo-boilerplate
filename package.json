{
  "name": "agro-rib",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:xcode": "xed ios/<coming_soon>.xcworkspace",
    "android:studio": "studio android",
    "start": "expo start --dev-client",
    "run": "expo run",
    "run:device": "expo run --device",
    "clean": "bun expo prebuild --clean",
    "build:android": "bun expo prebuild --clean -p android && cd android && ./gradlew app:assembleRelease",
    "build:ios": "bun expo prebuild --clean -p ios && xed ios/<coming_soon>.xcworkspace",
    "watch-del": "watchman watch-del-all",
    "format": "bun biome format --write && bun biome check --write"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "axios": "1.15.2",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.14",
    "expo-font": "~55.0.7",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.6",
    "i18next": "^25.8.13",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^15.7.4",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "uniwind": "^1.6.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@biomejs/biome": "2.4.8",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "clsx": "^2.1.1",
    "expo-dev-client": "~55.0.32",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.17",
    "react-native-svg-transformer": "^1.5.2",
    "reactotron-react-native": "^5.1.18",
    "reactotron-react-native-mmkv": "^0.2.9",
    "reactotron-react-query": "^2.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "zod": "^4.3.6"
  }
}
