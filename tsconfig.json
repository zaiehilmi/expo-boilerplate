{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["react-native", "jest", "bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./modules/*"],
      "@__mocks__/*": ["./__mocks__/*"]
    },
    "allowImportingTsExtensions": false,
    "module": "Preserve",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": [
    "__mocks__/**/*",
    "./src/**/*",
    "index.d.ts",
    "jest.setup.js",
    "jest.config.js",
    "babel.config.js",
    "index.js",
    "react-native.config.js",
    "jest.setup.ts",
    ".prettierrc.mjs",
    "app.config.ts",
    "uniwind-types.d.ts"
  ],
  "exclude": ["node_modules", "_", "android", "ios"]
}
